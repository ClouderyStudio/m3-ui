{
  "name": "@clderystd/m3-ui",
  "version": "0.5.0",
  "description": "云术工作室 Material Design 3 组件库：105 个组件、24 个组合式函数，官方 M3 令牌实现，配色由使用方注入",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/m3-ui.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/flatten-dts.mjs",
    "typecheck": "vue-tsc -b",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "material-design",
    "material-design-3",
    "material3",
    "md3",
    "vue",
    "vue3",
    "components",
    "ui",
    "design-tokens",
    "composables"
  ],
  "author": "云术工作室 <2675256772@qq.com>",
  "homepage": "https://github.com/ClouderyStudio/m3-ui#readme",
  "bugs": {
    "url": "https://github.com/ClouderyStudio/m3-ui/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.97",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "4.5.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClouderyStudio/m3-ui.git"
  },
  "license": "AGPL-3.0-only"
}
